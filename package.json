{
  "name": "dsh-cosplay-studio",
  "version": "2.1.0",
  "description": "Cosplay Studio for the DSH web GUI: one-click ComfyUI (Z-Image-Turbo) deployment with a self-test, then a character name, an uploaded reference photo, or a hot-character pick drives a staged character research (web search, image classification, vision feature extraction), a base-image gate with manual/smart retouch, a character-specific shot script, and 1440x2560 live-action cosplay finals with optional de-oil/makeup/export.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/tools/__pycache__",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "cosplay",
    "comfyui",
    "z-image-turbo",
    "text-to-image",
    "image-generation",
    "photo-set"
  ],
  "author": "Wang-Shuanglin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wang-Shuanglin/dsh-cosplay-studio.git"
  },
  "homepage": "https://github.com/Wang-Shuanglin/dsh-cosplay-studio#readme",
  "bugs": {
    "url": "https://github.com/Wang-Shuanglin/dsh-cosplay-studio/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  }
}
